# ════════════════════════════════════════════════════════════
# ALIVET AGROVETERINARIA — Variables de entorno
# Copia este archivo como ".env" y completa los valores reales.
# El ".env" real NUNCA debe subirse al repositorio (ya debería
# estar en .gitignore).
# ════════════════════════════════════════════════════════════

# ── Base de datos (obligatorio) ─────────────────────────────
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=alivetagroveterinaria_empresa
# DB_PORT=3306                      # opcional, default 3306

# Solo si despliegas en Google Cloud SQL con socket unix.
# Si está definida, tiene prioridad sobre DB_HOST.
# INSTANCE_CONNECTION_NAME=proyecto:region:instancia

# ── Autenticación (obligatorio) ─────────────────────────────
# Cadena larga y aleatoria para firmar los JWT. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Servidor ─────────────────────────────────────────────────
PORT=10000
NODE_ENV=desarrollo                 # "production" en el servidor real

# ── Consulta de DNI/RUC (Reniec/Sunat vía apisperu.com) ──────
# Sin esto, /api/auth/consultar-documento responde 503 mientras
# el resto de la app funciona normal (no bloquea el arranque).
APIS_PERU_TOKEN=

# ── Almacenamiento de imágenes — Cloudflare R2 (S3-compatible) ──
MINIO_ENDPOINT=
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=alivetagroveterinaria
# URL pública desde la que se sirven las imágenes subidas (sin / al final)
MINIO_PUBLIC_URL=

# ── Correo transaccional — Brevo (antes Sendinblue) ──────────
# Sin esto, los correos (OTP, bienvenida, recuperación, promociones)
# se omiten con un aviso en consola; la app sigue funcionando.
BREVO_API_KEY=
EMAIL_FROM=AgroVeterinaria <noreply@alivetagroveterinaria.pe>
SITE_URL=https://alivetagroveterinaria-web.onrender.com

# ── Notificaciones push — Firebase Cloud Messaging ───────────
# Sin esto, Firebase queda desactivado con un stub seguro: las
# notificaciones se guardan solo en BD, no se envían push.
# Usa UNA de las dos opciones:
#
# Opción A — JSON completo del service account en una sola línea:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
#
# Opción B — campos por separado (en FIREBASE_PRIVATE_KEY los
# saltos de línea van escapados como \n):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ── Módulo AgroBot — IA vía OpenRouter ────────────────────────
# Sin esto, el chat de AgroBot responde con error controlado.
OPENROUTER_API_KEY=
# Modelo usado como fallback #3 en la cadena de reintentos de agrobot
# (ver src/ia/openrouter.service.js). Puedes dejarlo vacío para usar
# el valor por defecto del código.
OPENROUTER_MODEL_3=

# ── Pagos con tarjeta — Culqi ──────────────────────────────────
# Llave SECRETA (nunca la publica ni la pública) de tu cuenta Culqi.
# Sin esto, el pago con tarjeta responde error controlado (no tumba
# el servidor). Ver src/servicios/culqi.service.js
CULQI_SECRET_KEY=

# ── Facturación electrónica SUNAT — NubeFacT ──────────────────
# Datos que te da NubeFacT al crear tu cuenta. Sin esto, la emisión
# de boleta/factura queda en estado_sunat='PENDIENTE' para reintentar
# después (no bloquea el pedido). Ver src/servicios/nubefact.service.js
NUBEFACT_RUTA=
NUBEFACT_TOKEN=